{
  "manifest_version": 3,
  "name": "Ext Install",
  "version": "0.4.0",
  "description": "GUI-first browser action bridge for extension repositories and install workflows.",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*", "http://127.0.0.1/*"],
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ext Install v0.4.0"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
